{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["node_modules/**", "build/**", "dist/**", "META-INF/**"],
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "endOfLine": "lf",
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  "sortPackageJson": true
}
