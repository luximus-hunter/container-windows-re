{
  "name": "container-windows-re",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Thomas Lipman",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "package": "pnpm run build && node build/tools/package.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run lint:extension && node build/tools/package.mjs",
    "lint:extension": "web-ext lint --source-dir build/extension --warnings-as-errors"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "fflate": "0.8.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
