{
  "name": "container-windows-re",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Thomas Lipman",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings . && npm run typecheck && npm run build && web-ext lint --source-dir build/extension --warnings-as-errors",
    "package": "npm run build && node build/tools/package.mjs",
    "check": "npm run format:check && npm run lint && npm run package",
    "format": "oxfmt --write \"**/*.{json,ts,html,md,mjs,yml,yaml}\" \".*.json\"",
    "format:check": "oxfmt --check \"**/*.{json,ts,html,md,mjs,yml,yaml}\" \".*.json\""
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "fflate": "0.8.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
